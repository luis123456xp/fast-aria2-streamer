{
  "manifest_version": 3,
  "name": "Aria2 Video Stream Bridge",
  "version": "1.9.0",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:7777/*",
    "http://localhost:7777/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "ui.css"
      ],
      "run_at": "document_idle"
    }
  ]
}